+            app/build/test-results/testDebugUnitTest/**/*.xml
+          if-no-files-found: error
+          retention-days: 7
+
+      - name: Summarize failed FULL unit tests
+        if: ${{ failure() && steps.full_gradle.outcome == 'failure' }}
