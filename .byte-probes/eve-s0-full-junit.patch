           retention-days: 14
 
       - name: FULL test lint and compile AndroidTest sources
+        id: full_gradle
         if: ${{ steps.verification_profile.outputs.full == 'true' }}
         run: |
           set -euo pipefail
           gradle :app:compileDebugUnitTestKotlin :app:compileDebugAndroidTestKotlin :app:assembleDebugAndroidTest :app:lintDebug :app:testDebugUnitTest --continue --stacktrace --console=plain 2>&1 | tee ci-full-gradle.log
+
+      - name: Archive failed FULL unit test evidence
